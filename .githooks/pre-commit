#!/usr/bin/env bash
# Refuse to commit secrets. Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail
fail=0

# (a) never commit these paths — even with `git add -f`. Templates (*.example) are fine.
blocked='(^|/)(\.env(\..+)?|secrets\.ya?ml|inventory\.ini|[^/]+\.pem|[^/]+\.key|id_(rsa|ed25519)[^/]*|\.vault_pass)$'
while IFS= read -r -d '' f; do
  case "$f" in *.example|*.example.*) continue ;; esac
  if printf '%s' "$f" | grep -qiE "$blocked"; then
    echo "✗ refusing to commit secret file: $f" >&2; fail=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

# (b) never commit these values, wherever they appear — EXCEPT in *.example templates.
# shellcheck disable=SC2016 # The Ansible Vault header is an intentionally literal regex marker.
# Split its spelling so the guard does not match its own source when this file is first committed.
markers='(tskey-(auth|client)-[A-Za-z0-9_-]{10,}|TUNNEL_TOKEN[[:space:]]*[:=][[:space:]]*["'"'"']?eyJ[A-Za-z0-9_-]{10,}|BEGIN [A-Z ]*PRIVATE KEY|\$ANSIBLE_''VAULT)'
scan_files=()
while IFS= read -r -d '' f; do
  case "$f" in *.example|*.example.*) continue ;; esac
  scan_files+=("$f")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#scan_files[@]}" -gt 0 ] && git diff --cached -U0 -- "${scan_files[@]}" | grep -E '^\+' | grep -E "$markers" >/dev/null; then
  echo "✗ refusing to commit: staged changes contain what looks like a secret (token/key)." >&2
  echo "  move it into a gitignored secrets file (see ops/group_vars/all/secrets.example.yml)." >&2
  fail=1
fi

[ "$fail" -eq 0 ] || { echo "commit blocked by .githooks/pre-commit" >&2; exit 1; }
