{
  "schema_version": 2,
  "cloudflare_plan": "free",
  "phase": "http_ratelimit",
  "ruleset_name": "Burnerpad Free-plan rate limiting",
  "ruleset_description": "Burnerpad production edge protection for Cloudflare Free",
  "rules": [
    {
      "ref": "burnerpad_public_edge_free_v1",
      "description": "Burnerpad health, readiness, and static edge protection v1",
      "enabled": true,
      "expression": "(http.request.uri.path in {\"/healthz\" \"/readyz\"} or starts_with(http.request.uri.path, \"/crypto/\") or starts_with(http.request.uri.path, \"/fonts/\"))",
      "action": "block",
      "ratelimit": {
        "characteristics": [
          "cf.colo.id",
          "ip.src"
        ],
        "period": 10,
        "requests_per_period": 100,
        "mitigation_timeout": 10,
        "requests_to_origin": false
      }
    }
  ]
}
