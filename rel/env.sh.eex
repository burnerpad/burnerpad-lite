#!/bin/sh
# Bind Erlang distribution to LOOPBACK only (C1). `bin/burnerpad rpc` (operator takedowns) still works from
# inside the container, but EPMD and the distribution listener are unreachable from any other host or
# container — closing the remote-code-execution path an image-baked cookie would otherwise open.
#
# Use a longname pinned to 127.0.0.1 (NOT sname): with sname the node name carries the machine hostname,
# which resolves off-loopback, so a loopback-bound listener rejects `rpc`'s own connection. name@127.0.0.1
# keeps both the node identity AND the listener on loopback, so rpc connects to 127.0.0.1 and succeeds.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=burnerpad@127.0.0.1
export ERL_EPMD_ADDRESS=127.0.0.1
export ELIXIR_ERL_OPTIONS="-kernel inet_dist_use_interface {127,0,0,1}"

# Public images deliberately contain no releases/COOKIE. Deployment MUST inject a fresh high-entropy
# RELEASE_COOKIE at runtime; refusing to invent a fallback prevents publishing or reusing an RPC secret.
case "${RELEASE_COOKIE:-}" in
  *[!A-Za-z0-9]*)
    echo "RELEASE_COOKIE must be at least 64 alphanumeric characters" >&2
    exit 1
    ;;
esac
if [ "${#RELEASE_COOKIE}" -lt 64 ]; then
  echo "RELEASE_COOKIE must be at least 64 alphanumeric characters" >&2
  exit 1
fi

# No crash dumps on disk (they can contain live ciphertext) — belt to the container's ERL_CRASH_DUMP_SECONDS.
export ERL_CRASH_DUMP_SECONDS=0
