# Copy to `.env` (gitignored) on the box. Put REAL secrets only here — never commit them.
APP_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:CHANGE_ME
CLOUDFLARED_IMAGE=ghcr.io/OWNER/REPOSITORY-cloudflared@sha256:CHANGE_ME
RELEASE_COOKIE=GENERATE_A_FRESH_64_CHARACTER_VALUE_FOR_EVERY_DEPLOY
TUNNEL_TOKEN=CHANGE_ME              # Cloudflare Zero Trust → Tunnels → token
OPERATOR_NAME=CHANGE_ME_LEGAL_OPERATOR
ABUSE_EMAIL=abuse@example.invalid
JURISDICTION=CHANGE_ME_JURISDICTION
SECURITY_EMAIL=security@example.invalid
SECURITY_POLICY_URL=https://example.invalid/CHANGE_ME_SECURITY_POLICY
BURNERPAD_REVISION=CHANGE_ME_FULL_40_CHARACTER_GIT_SHA
BURNERPAD_IMAGE_DIGEST=sha256:CHANGE_ME_64_HEX_DIGITS
MAX_SECRETS=10000
GLOBAL_CREATE_CEILING=1000
PER_IP_BUDGET=13107200
PER_IP_ROW_BUDGET=200
STATE_CALL_TIMEOUT_MS=1000
